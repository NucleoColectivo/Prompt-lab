{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|og-whatsapp\\.jpg|favicon\\.svg|favicon-32x32\\.png|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
